{
  "name": "mcp-dashboard",
  "version": "1.0.0",
  "description": "MCP server for generating dashboard charts (Russia map and more). Standalone project.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare:data": "echo 'Region data is in data/. To refresh, run from repo root: npx tsx scripts/export-regions-for-mcp-dashboard.ts'",
    "test": "bash scripts/test.sh",
    "e2e:mcp": "bash scripts/test.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "better-sqlite3": "^11.6.0",
    "express": "^4.21.0",
    "puppeteer": "^23.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
