# ---- E2E-клиент (npm test, scripts/test.sh) — базовый URL берётся из env по цепочке ----
# 1) MCP_BASE_URL=http://host:3100  — явно (перекрывает всё)
# 2) MCP_DASHBOARD_BASE_URL=...     — как в docker-compose
# 3) SERVER_IP + MCP_DASHBOARD_PORT или PORT → http://SERVER_IP:порт  (удобно с тем же .env, что и deploy.sh)
# 4) BASE_URL
# 5) иначе http://localhost:3100
# MCP_BASE_URL=http://localhost:3100

# Порт HTTP-сервера (дашборды + API)
PORT=3100

# Базовый URL для ссылок на дашборды (на деплое подставляется из SERVER_IP)
# Локально: BASE_URL=http://localhost:3100
BASE_URL=http://localhost:3100

# Путь к SQLite БД (по умолчанию ./data/dashboards.db)
DATABASE_PATH=./data/dashboards.db

# ---- Деплой (для scripts/deploy.sh и docker-compose) ----
# SERVER_IP=130.193.46.4
# SERVER_USER=appuser
# SSH_KEY=~/.ssh/llm-cpu/appuser-ed25519
# PROJECT_DIR=mcp_dashboard
# Порт на хосте и публичный URL (для docker-compose)
# MCP_DASHBOARD_PORT=3100
# На сервере BASE_URL собирается из SERVER_IP (см. docker-compose). Переопределение:
# MCP_DASHBOARD_BASE_URL=http://YOUR_SERVER_IP:3100
# Dozzle (логи контейнеров)
# DOZZLE_PORT=9999
